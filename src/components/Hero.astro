---
import { Image } from 'astro:assets';
import heroFoto from '../assets/images/hero-foto.jpg';
---

<section class='relative w-full flex flex-col md:flex-row overflow-hidden'>
  <!-- Bloque de texto -->
  <div
    class='relative z-10 w-full md:w-[55%] bg-azul-50 px-6 md:px-16 py-20 flex flex-col justify-center'
  >
    <h1 class='text-4xl md:text-5xl mb-4'>
      Educación que forma personas, no solo estudiantes
    </h1>
    <p class='font-cuerpo text-grisTexto text-lg mb-8 max-w-md'>
      Preescolar y primaria con un método que acompaña a cada niño en su
      desarrollo académico y humano.
    </p>
    <div class='flex flex-wrap gap-4'>
      <a
        href='/contacto'
        class='bg-amarillo-marca hover:bg-amarillo-hover text-azul-900 font-titulo font-bold px-6 py-3 rounded-full transition-colors'
      >
        Agenda una visita
      </a>
      <a
        href='/oferta-educativa'
        class='border-2 border-azul-marca text-azul-marca font-titulo font-bold px-6 py-3 rounded-full hover:bg-azul-marca hover:text-white transition-colors'
      >
        Conoce la oferta
      </a>
    </div>
  </div>

  <!-- Bloque de foto (marcador de posición hasta tener la imagen real) -->
  <div
    class='relative w-full md:w-[45%] h-72 md:h-auto bg-azul-200 flex items-center justify-center'
  >
    <Image
      src={heroFoto}
      alt='Fachada del Colegio Jean Piaget'
      class='w-full h-full object-cover'
      loading='eager'
      fetchpriority='high'
    />
  </div>

  <!-- Divisor curvo: nace exactamente en el borde del texto (55%) y solo
       se abulta hacia la derecha, nunca "retrocede" dejando huecos. -->
  <svg
    class='hidden md:block absolute top-0 h-full w-10 text-azul-50 pointer-events-none'
    style='left: 55%;'
    viewBox='0 0 40 800'
    preserveAspectRatio='none'
  >
    <path d='M0,0 C32,267 32,533 0,800 Z' fill='currentColor'></path>
  </svg>
</section>
