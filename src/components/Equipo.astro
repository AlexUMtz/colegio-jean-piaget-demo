---
// Equipo: por seguridad, sin fotos ni nombres de personas. Solo se
// muestran los roles, con un ícono genérico, para comunicar que hay
// un equipo estructurado sin identificar a nadie individualmente.
const equipo = [
  { puesto: 'Dirección general', icono: 'persona' },
  { puesto: 'Dirección de preescolar', icono: 'persona' },
  { puesto: 'Dirección de primaria', icono: 'grupo' },
  { puesto: 'Docentes', icono: 'grupo' },
] as const;

// Dos íconos simples de línea, reutilizados entre roles individuales
// (persona) y roles colectivos (grupo), consistentes con el estilo de
// ícono ya usado en Pilares (solo trazo, sin relleno).
const iconos = {
  persona:
    'M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2M12 11a4 4 0 100-8 4 4 0 000 8z',
  grupo:
    'M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75',
};
---

<section class='bg-azul-50 py-20'>
  <div class='max-w-5xl mx-auto px-6'>
    <p
      class='text-xs font-titulo font-bold tracking-widest text-azul-500 uppercase mb-2 text-center'
    >
      Conócenos
    </p>
    <h2 class='text-3xl md:text-4xl text-center mb-4'>Nuestro equipo</h2>
    <p class='font-cuerpo text-grisTexto text-center max-w-xl mx-auto mb-12'>
      Un equipo comprometido con la formación de cada alumno, en todos los
      niveles.
    </p>

    <div class='grid sm:grid-cols-2 lg:grid-cols-4 gap-8'>
      {
        equipo.map((rol, indice) => (
          <div
            class='reveal text-center'
            style={`transition-delay: ${indice * 100}ms`}
          >
            <div class='w-20 h-20 mx-auto mb-4 rounded-full bg-azul-marca flex items-center justify-center'>
              <svg
                class='w-9 h-9 text-white'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='1.5'
                stroke-linecap='round'
                stroke-linejoin='round'
              >
                <path d={iconos[rol.icono]} />
              </svg>
            </div>
            <h3 class='text-base font-titulo font-bold text-azul-marca'>
              {rol.puesto}
            </h3>
          </div>
        ))
      }
    </div>
  </div>
</section>
