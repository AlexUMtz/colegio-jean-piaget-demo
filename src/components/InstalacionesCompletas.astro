---
import { Image } from 'astro:assets';
import img1 from '../assets/images/instalaciones-completas-1.jpg';
import img2 from '../assets/images/instalaciones-completas-2.jpg';
import img3 from '../assets/images/instalaciones-completas-3.jpg';
import img4 from '../assets/images/instalaciones-completas-4.jpg';

// Instalaciones, versión completa para ¿Quiénes somos? (distinta al
// mosaico chico de Inicio): cuadrícula uniforme con más espacios y una
// breve descripción debajo de cada foto. Fotos [EJEMPLO] hasta tener
// las reales.
const espacios = [
  {
    nombre: 'Salones de preescolar',
    texto: 'Espacios luminosos, pensados para el juego y la exploración.',
    imagen: img1,
  },
  {
    nombre: 'Salones de primaria',
    texto: 'Equipados para el trabajo individual y en equipo.',
    imagen: img2,
  },
  {
    nombre: 'Salón de cómputo',
    texto:
      'Equipado para el desarrollo de habilidades digitales desde los primeros grados.',
    imagen: img3,
  },
  {
    nombre: 'Patio de juegos',
    texto: 'Pensado especialmente para los alumnos de preescolar.',
    imagen: img4,
  },
];
---

<section class='bg-white py-20'>
  <div class='max-w-5xl mx-auto px-6'>
    <p
      class='text-xs font-titulo font-bold tracking-widest text-azul-500 uppercase mb-2 text-center'
    >
      Conócenos
    </p>
    <h2 class='text-3xl md:text-4xl text-center mb-12'>
      Nuestras instalaciones
    </h2>

    <div class='grid sm:grid-cols-2 gap-8 max-w-3xl mx-auto'>
      {
        espacios.map((espacio, indice) => (
          <div class='reveal' style={`transition-delay: ${indice * 100}ms`}>
            <div class='group relative h-48 rounded-lg overflow-hidden shadow-sm hover:shadow-lg transition-shadow duration-500 ease-out mb-3'>
              <Image
                src={espacio.imagen}
                alt={espacio.nombre}
                class='absolute inset-0 w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105'
              />
            </div>
            <h3 class='text-base font-titulo font-bold text-azul-marca mb-1'>
              {espacio.nombre}
            </h3>
            <p class='font-cuerpo text-grisTexto text-sm'>{espacio.texto}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
